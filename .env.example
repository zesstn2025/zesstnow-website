# Zesst Now — environment variables
#
# Copy this file to .env.local and fill in the values. .env.local is in
# .gitignore and must stay there; this file carries names only, never values.
#
# ── A note on the naming ──────────────────────────────────────────────
# None of these carry a NEXT_PUBLIC_ prefix, and that is the whole point.
# Next.js inlines any variable named NEXT_PUBLIC_* into the JavaScript the
# browser downloads — anyone can read it in the network tab. Everything below
# is read only inside app/api/enquiry/route.ts, which runs on the server, so
# the keys never reach the bundle.
#
# (If you have seen VITE_* names for these: that is the Vite convention, and
# VITE_* variables are likewise exposed to the client. This project is Next.js,
# and an API key must not be exposed either way.)
#
# On Vercel: Project → Settings → Environment Variables. Add each one to
# Production, Preview and Development. A variable added to only one of the
# three is the usual reason a form works locally and not on the live site.


# ── Where enquiries go ────────────────────────────────────────────────

# The inbox that receives the enquiry. Defaults to the address in
# content/site.ts if unset.
ENQUIRY_TO_EMAIL=zesstn@gmail.com

# The founder's WhatsApp number, digits only with the country code and no plus.
# Defaults to the company number in content/site.ts if unset.
ENQUIRY_TO_WHATSAPP=917753898481


# ── Email ─────────────────────────────────────────────────────────────
# Two transports. Fill in EITHER. If both are present Resend is used and SMTP
# becomes the fallback when a Resend send fails.
#
# With neither, the form still works: it hands the finished enquiry to
# WhatsApp or to the mail client from the browser, so nothing is lost — but
# the visitor has to tap a second time, so one of these is worth setting.


# Option A — SMTP. Nothing to sign up for; it sends from a mailbox you
# already own, and it is the one that can be working in five minutes.
#
# For Gmail: SMTP_PASS must be an APP PASSWORD, not the account password.
# Google refuses account passwords from applications outright, and the
# failure looks like a typo. Generating one needs 2-Step Verification on:
# myaccount.google.com > Security > 2-Step Verification > App passwords.
#
# Port 465 is TLS from the first byte; 587 upgrades with STARTTLS. Either is
# encrypted. Leave the port alone unless your provider says otherwise.
#
# The ceiling is a few hundred messages a day on a normal Gmail account —
# far beyond what a contact form produces, but it is a real limit, and mail
# goes out From that mailbox rather than from your own domain.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=zesstn@gmail.com
SMTP_PASS=

# Option B — Resend (https://resend.com). Better once it is set up: real
# delivery reporting, no per-mailbox ceiling, sends from your own domain.
# Needs an account and a domain verified by DNS before it will send at all.

RESEND_API_KEY=

# Required by Resend, optional for SMTP. Must be an address on a domain
# verified in the Resend account — Resend refuses anything else, so it cannot
# be derived automatically. For example: enquiries@cognitivecapitalsuite.com
# Left empty with SMTP, mail is sent From SMTP_USER.
ENQUIRY_FROM_EMAIL=


# ── WhatsApp ──────────────────────────────────────────────────────────
# Two providers are supported. Fill in ONE set; whichever is present is used,
# and the Cloud API is preferred if both are.
#
# Read this before wiring either up, because it is the usual reason a working
# integration sends nothing: WhatsApp only allows free-form text inside a
# 24-hour window opened by the recipient messaging the business number. An
# alert arriving at 3am, days after the last reply, falls outside that window
# and must be an approved template. Set WHATSAPP_TEMPLATE_NAME once you have a
# template approved; without it the code sends free-form text, which is right
# for testing and unreliable in production.

# Option A — Meta WhatsApp Cloud API
# developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional. Without it, free-form text is sent (see the note above).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Optional. Defaults to v21.0.
WHATSAPP_API_VERSION=

# Option B — Twilio
# console.twilio.com. TWILIO_WHATSAPP_FROM is the sender, e.g. whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=


# ── Enquiry payload encryption (optional) ─────────────────────────────
# Generate a pair with:  node scripts/enquiry-keys.mjs
#
# The browser encrypts the submission with AES-256-GCM under a key derived per
# submission by ECDH against the public key below; only the holder of the
# private key can open it. This sits UNDERNEATH TLS as defence in depth — it
# means a proxy that terminates TLS, or a platform that logs request bodies,
# sees ciphertext rather than names and phone numbers.
#
# It is not end-to-end encryption and is not described as such anywhere on the
# site: the server has to hold the plaintext to compose the email and the
# WhatsApp message, so the server can read every enquiry by necessity.
#
# With these unset the form posts plain JSON over TLS, which is the ordinary and
# safe arrangement.
#
# The public half is deliberately published to the browser — that is what makes
# it safe. The private half must never carry a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_ENQUIRY_PUBLIC_KEY=
ENQUIRY_PRIVATE_KEY=

# Set to 1 only AFTER confirming the form still submits with the keys in place.
# It refuses plaintext submissions, and a browser without Web Crypto (an
# insecure context, for instance) can only send plaintext.
ENQUIRY_REQUIRE_ENCRYPTION=


# ── Already in use elsewhere on the site ──────────────────────────────

# The canonical origin, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.cognitivecapitalsuite.com

# The admin CMS sign-in (app/api/admin/*). Not related to the contact form.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
